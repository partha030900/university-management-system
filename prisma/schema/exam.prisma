model Exam {
  id         Int      @id @default(autoincrement())
  title      String
  type       ExamType
  totalMarks Float

  sectionId  Int
  section    Section @relation(fields: [sectionId], references: [id])

  examDate   DateTime

  results Result[]
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("exams")
}