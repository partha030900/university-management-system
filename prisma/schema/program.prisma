model Program {
  id           Int        @id @default(autoincrement())
  name         String
  code         String     @unique
  duration     Int
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  students     Student[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt


  @@map("programs")
}