model Instructor {
    id           Int        @id @default(autoincrement())
    userId       Int        @unique
    employeeId   String     @unique
    name         String
    departmentId Int
    department   Department @relation(fields: [departmentId], references: [id])
    designation  String?

    sections Section[]
    
    createdAt    DateTime   @default(now())
    updatedAt    DateTime   @updatedAt
}
