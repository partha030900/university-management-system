model Course {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  title       String
  description String?
  credits     Float

  prerequisites Course[] @relation("CoursePrerequisites")
  requiredFor   Course[] @relation("CoursePrerequisites")

  sections Section[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}